{
  "app": {
    "name": "Unsafe Fixture",
    "bundle_id": "com.example.badfixture",
    "version": "1.0",
    "build": "1",
    "platforms": ["ios"],
    "device_families": ["iphone"],
    "locales": ["en-US"],
    "primary_locale": "en-US"
  },
  "features": {
    "accounts": {
      "creation": true,
      "deletion_in_app": false,
      "social_logins": ["google"],
      "privacy_preserving_login": false,
      "login_exception": null
    },
    "ai": {
      "enabled": true,
      "providers": ["OpenAI"],
      "third_party": true,
      "personal_data_types": ["user-entered text"]
    },
    "commerce": {
      "digital_goods": false,
      "iap": false,
      "restore_purchases": false
    },
    "ugc": {"enabled": false},
    "permissions": ["camera"]
  }
}
