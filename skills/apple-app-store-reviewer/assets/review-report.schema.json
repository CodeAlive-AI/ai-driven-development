{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apple-app-store-reviewer/review-report.schema.json",
  "title": "Apple App Store preflight review report",
  "type": "object",
  "required": [
    "schema_version", "skill", "generated_at", "policy", "app", "inputs",
    "tools", "checks", "facts", "findings", "gate"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "apple-app-store-reviewer"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "required": ["baseline_date", "guidelines_last_updated", "freshness"],
      "properties": {
        "baseline_date": {"type": "string", "format": "date"},
        "guidelines_last_updated": {"type": "string", "format": "date"},
        "freshness": {"enum": ["CURRENT", "STALE", "UNVERIFIED", "NOT_CHECKED"]},
        "observed_guidelines_last_updated": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "app": {"type": "object"},
    "scope": {"type": "object"},
    "inputs": {"type": "object"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "detail": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "facts": {"type": "object"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "gate": {
      "type": "object",
      "required": ["state", "reasons", "unresolved_counts", "mandatory_unverified", "strict", "disclaimer"],
      "properties": {
        "state": {"enum": ["NOT READY", "CONDITIONALLY READY", "READY FOR SUBMISSION"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "unresolved_counts": {
          "type": "object",
          "required": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "mandatory_unverified": {"type": "array", "items": {"type": "string"}},
        "strict": {"type": "boolean"},
        "disclaimer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "location", "detail"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "value": {}
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["id", "title", "status", "mandatory", "detail", "tool", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "PASS", "SKIPPED", "NEEDS_REVIEW", "FIXED", "ACCEPTED_RISK", "ERROR"]},
        "mandatory": {"type": "boolean"},
        "detail": {"type": "string"},
        "tool": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "id", "title", "severity", "status", "category", "guideline", "confidence",
        "evidence", "rationale", "remediation", "verification", "sources", "automation", "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,159}$"},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"]},
        "status": {"enum": ["OPEN", "PASS", "SKIPPED", "NEEDS_REVIEW", "FIXED", "ACCEPTED_RISK", "ERROR"]},
        "category": {"type": "string", "minLength": 1},
        "guideline": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["CERTAIN", "HIGH", "MEDIUM", "LOW"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "rationale": {"type": "string", "minLength": 1},
        "remediation": {"type": "string", "minLength": 1},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "automation": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
