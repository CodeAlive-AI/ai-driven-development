{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apple-app-store-reviewer/review-input.schema.json",
  "title": "Apple App Store Reviewer input",
  "type": "object",
  "required": [
    "app",
    "paths",
    "features"
  ],
  "additionalProperties": true,
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "bundle_id",
        "platforms",
        "device_families",
        "storefronts",
        "locales"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]+$"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "new_app": {
          "type": "boolean",
          "default": true
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ios",
              "ipados",
              "macos",
              "tvos",
              "watchos",
              "visionos"
            ]
          }
        },
        "device_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "iphone",
              "ipad",
              "mac",
              "apple-tv",
              "apple-watch",
              "vision-pro"
            ]
          }
        },
        "storefronts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "primary_locale": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "minimum_user_age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "price_model": {
          "enum": [
            "free",
            "paid",
            "freemium",
            "subscription",
            "unknown"
          ]
        },
        "company_name": {
          "type": "string"
        },
        "competitor_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshots": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacy_export": {
          "type": [
            "string",
            "null"
          ]
        },
        "iap_export": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_results": {
          "type": [
            "string",
            "null"
          ]
        },
        "ai_results": {
          "type": [
            "string",
            "null"
          ]
        },
        "visual_results": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_value_dossier": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_json": {
          "type": ["string", "null"]
        },
        "javascript_lockfile": {
          "type": ["string", "null"]
        },
        "capacitor_config": {
          "type": ["string", "null"]
        },
        "web_build": {
          "type": ["string", "null"]
        },
        "ios_project": {
          "type": ["string", "null"]
        },
        "native_web_assets": {
          "type": ["string", "null"]
        },
        "package_resolved": {
          "type": ["string", "null"]
        },
        "podfile_lock": {
          "type": ["string", "null"]
        },
        "live_update_manifest": {
          "type": ["string", "null"]
        }
      }
    },
    "frameworks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capacitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["auto", "enabled", "disabled"], "default": "auto"},
            "minimum_version": {"const": "8.5.0"},
            "tested_version_range": {"const": ">=8.5.0 <9.0.0"},
            "native_project_policy": {"enum": ["auto", "committed", "generated"]},
            "package_manager": {"enum": ["auto", "spm", "cocoapods"]},
            "trusted_cli": {"type": "boolean", "default": false},
            "release_environment": {"type": "string", "default": "production"},
            "expected_plugins": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "custom_bridge": {"type": "boolean", "default": false},
            "custom_view_controller": {"type": "boolean", "default": false},
            "live_updates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean", "default": false},
                "provider": {"type": "string", "default": "none"}
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "accounts": {
          "type": "object",
          "properties": {
            "creation": {
              "type": "boolean"
            },
            "login_required": {
              "type": "boolean"
            },
            "deletion_in_app": {
              "type": "boolean"
            },
            "social_logins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "privacy_preserving_login": {
              "type": "boolean"
            },
            "login_exception": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ai": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "third_party": {
              "type": "boolean"
            },
            "on_device": {
              "type": "boolean"
            },
            "foundation_models": {
              "type": "boolean"
            },
            "chatbot": {
              "type": "boolean"
            },
            "personal_data_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "explicit_consent_before_transmission": {
              "type": "boolean"
            },
            "provider_named_in_consent": {
              "type": "boolean"
            },
            "training_opt_in": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "retention_documented": {
              "type": "boolean"
            },
            "high_impact_domain": {
              "type": [
                "string",
                "null"
              ]
            },
            "outputs_publicly_shared": {
              "type": "boolean"
            },
            "safety_controls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ugc": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "public_feed": {
              "type": "boolean"
            },
            "chat_or_messaging": {
              "type": "boolean"
            },
            "filter": {
              "type": "boolean"
            },
            "report": {
              "type": "boolean"
            },
            "block": {
              "type": "boolean"
            },
            "support_contact": {
              "type": "boolean"
            },
            "creator_content": {
              "type": "boolean"
            },
            "age_restriction": {
              "type": "boolean"
            }
          }
        },
        "commerce": {
          "type": "object",
          "properties": {
            "digital_goods": {
              "type": "boolean"
            },
            "physical_goods": {
              "type": "boolean"
            },
            "person_to_person_real_time": {
              "type": "boolean"
            },
            "enterprise_only": {
              "type": "boolean"
            },
            "reader_app": {
              "type": "boolean"
            },
            "multiplatform": {
              "type": "boolean"
            },
            "iap": {
              "type": "boolean"
            },
            "subscriptions": {
              "type": "boolean"
            },
            "credits": {
              "type": "boolean"
            },
            "external_purchase_links": {
              "type": "boolean"
            },
            "restore_purchases": {
              "type": "boolean"
            },
            "manage_subscriptions": {
              "type": "boolean"
            }
          }
        },
        "ads_tracking": {
          "type": "object",
          "properties": {
            "ads": {
              "type": "boolean"
            },
            "tracking": {
              "type": "boolean"
            },
            "att": {
              "type": "boolean"
            },
            "marketing_push": {
              "type": "boolean"
            },
            "marketing_push_opt_in": {
              "type": "boolean"
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specialized": {
          "type": "array",
          "items": {
            "enum": [
              "kids",
              "medical",
              "health",
              "finance",
              "loans",
              "crypto",
              "gambling",
              "dating",
              "vpn",
              "mdm",
              "browser",
              "remote-desktop",
              "extensions",
              "keyboard",
              "carplay",
              "news",
              "education",
              "government",
              "nonprofit",
              "marketplace",
              "mini-apps",
              "emulator"
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "string"
        },
        "demo_account": {
          "type": "object",
          "properties": {
            "username_env": {
              "type": "string"
            },
            "password_env": {
              "type": "string"
            },
            "non_expiring": {
              "type": "boolean"
            },
            "two_factor_bypass": {
              "type": "string"
            }
          }
        },
        "backend_live": {
          "type": "boolean"
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheme": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_plan": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "type": "string"
        },
        "configuration": {
          "type": "string"
        },
        "result_bundle": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra_xcodebuild_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_journey_tests": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+){1,2}$"
          },
          "description": "Xcode test identifiers executed with controlled -only-testing arguments. Include the clean-install reviewer path and relevant denial/failure states."
        }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
