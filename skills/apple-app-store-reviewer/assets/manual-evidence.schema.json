{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apple-app-store-reviewer/manual-evidence.schema.json",
  "title": "Agent/manual review evidence",
  "type": "object",
  "required": ["schema_version", "reviewer", "reviewed_at", "checks", "findings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "reviewer": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["ai-agent-vision", "human", "hybrid"]},
        "name": {"type": "string", "minLength": 1},
        "model_or_role": {"type": "string"}
      },
      "additionalProperties": true
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "object"},
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "verdict", "observations"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "verdict": {"enum": ["PASS", "FAIL", "NEEDS_REVIEW"]},
          "observations": {"type": "array", "items": {"type": "string"}},
          "claims_observed": {"type": "array", "items": {"type": "string"}},
          "sensitive_data_observed": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "mandatory", "detail", "tool", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"enum": ["OPEN", "PASS", "SKIPPED", "NEEDS_REVIEW", "FIXED", "ACCEPTED_RISK", "ERROR"]},
          "mandatory": {"type": "boolean"},
          "detail": {"type": "string"},
          "tool": {"type": "string"},
          "evidence": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "findings": {"type": "array", "items": {"type": "object"}},
    "facts": {"type": "object"}
  }
}
