#!/usr/bin/perl
use strict;
use warnings;
use Fcntl qw(:flock);
use File::Path qw(make_path);
use File::Basename qw(basename);
use JSON::PP;
use Time::HiRes qw(time sleep);

# Thresholds for identifying busy holders and limiting admission.
my $GRACE = $ENV{MAC_HEAVY_GRACE} // 45; # Seconds before an idle holder can lend.
my $BUSY_CPU = $ENV{MAC_HEAVY_BUSY_CPU} // 50; # Tree CPU percentage considered busy.
my $BUSY_RSS_MB = $ENV{MAC_HEAVY_BUSY_RSS_MB} // 1024; # Tree RSS considered busy.
my $MAX_BUSY = $ENV{MAC_HEAVY_MAX_BUSY} // 1; # Busy holders that prevent admission.

# Paths for the queue, compatibility lock, guard, and ledger.
umask 077;
my $root = `getconf DARWIN_USER_TEMP_DIR`;
chomp $root;
if (!$root || !-d $root) {
    $root = $ENV{TMPDIR} // '';
}
if (!$root || !-d $root) {
    $root = '/tmp/';
}
$root =~ s{/*$}{/};
my $dir = $ENV{MAC_HEAVY_DIR} // "${root}mac-heavy";
my $state = "$ENV{HOME}/.local/state/mac-heavy";
my $guard = $ENV{MAC_HEAVY_STATUS_PATH}
    // "$ENV{HOME}/.local/state/mac-health/memory-guard.status";
eval {
    make_path("$dir/holders", "$dir/waiters", $state, {mode => 0700});
    1;
} or die "mac-heavy: cannot create queue directory: $@; nothing ran\n";
my $boot = `sysctl -n kern.boottime`;
$boot =~ /sec = (\d+), usec = (\d+)/
    or die "mac-heavy: cannot read boot identity; nothing ran\n";
$boot = sprintf '%s.%06d', $1, $2;

# Helpers for identity, state files, guard status, and process trees.
sub identity {
    my ($pid) = @_;
    my $start = `ps -p $pid -o lstart= 2>/dev/null`;
    $start =~ s/^\s+|\s+$//g;
    return $start;
}
sub read_file {
    my ($path) = @_;
    open my $file, '<', $path or return '';
    local $/;
    return <$file> // '';
}
sub decode_file {
    my ($path) = @_;
    return eval { JSON::PP->new->decode(read_file($path)) } || {};
}
sub write_file {
    my ($path, $value) = @_;
    open my $file, '>', $path or die "mac-heavy: cannot write $path: $!; nothing ran\n";
    print $file JSON::PP->new->encode($value);
    close $file or die "mac-heavy: cannot write $path: $!; nothing ran\n";
}
sub guard_status {
    my @v = split /\s+/, read_file($guard);
    my $age = @v ? int(time) - $v[0] : -1;
    return ('unavailable', 'missing') unless @v;
    return ('unavailable', 'invalid') unless @v == 8 && $v[0] =~ /^\d+$/
        && $v[2] =~ /^(?:CALM|ALERT|EMERGENCY)$/
        && !grep { $_ !~ /^\d+$/ } @v[3, 4, 5, 7];
    return ('unavailable', 'invalid') unless $v[6] =~ /^(?:-1|[0-4])$/;
    return ('unavailable', 'different boot') if $v[1] ne $boot;
    return ('unavailable', 'stale') if $age < 0 || $age >= 10;
    my $line = "$v[2] segments=$v[3]% swap=$v[4] growth60=$v[5] "
        . "pressure=$v[6] frozen=$v[7] age=${age}s";
    return ($v[2], $line);
}
sub live {
    my ($pid, $holder) = @_;
    return $pid =~ /^\d+$/ && $pid > 0 && kill(0, $pid)
        && ($holder->{boot} // '') eq $boot && ($holder->{start} // '') ne ''
        && identity($pid) eq $holder->{start};
}
sub snapshot {
    my %processes;
    open my $ps, '-|', 'ps', '-axo', 'pid,ppid,pcpu,rss' or return \%processes;
    while (<$ps>) {
        if (/^\s*(\d+)\s+(\d+)\s+([\d.]+)\s+(\d+)/) {
            $processes{$1} = [$2, $3, $4];
        }
    }
    close $ps;
    return \%processes;
}
sub measure {
    my ($pid, $epoch, $processes) = @_;
    my %tree = ($pid => 1);
    my $changed = 1;
    while ($changed) {
        $changed = 0;
        for my $p (keys %$processes) {
            if (!$tree{$p} && $tree{$processes->{$p}[0]}) {
                $tree{$p} = 1;
                $changed = 1;
            }
        }
    }
    my ($cpu, $rss) = (0, 0);
    for my $p (keys %tree) {
        next unless $processes->{$p};
        $cpu += $processes->{$p}[1];
        $rss += $processes->{$p}[2];
    }
    $rss = int($rss / 1024);
    $cpu = int($cpu + .5);
    my $busy = time - $epoch < $GRACE || $cpu >= $BUSY_CPU || $rss >= $BUSY_RSS_MB;
    return ($cpu, $rss, $busy);
}
sub command_line {
    my ($pid, $limit) = @_;
    my $line = `ps -p $pid -o command= 2>/dev/null`;
    $line =~ s/^\s+|\s+$//g;
    $line =~ s/[\r\n]+/ /g;
    return substr($line, 0, $limit);
}
sub suspended {
    my ($pid) = @_;
    my (%parent, %stopped, %tree);
    $tree{$pid} = 1;
    open my $ps, '-|', 'ps', '-axo', 'pid,ppid,stat' or return 0;
    while (<$ps>) {
        if (/^\s*(\d+)\s+(\d+)\s+(\S+)/) {
            my ($p, $ppid, $stat) = ($1, $2, $3);
            $parent{$p} = $ppid;
            $stopped{$p} = ($stat =~ /T/);
        }
    }
    close $ps;
    my $changed = 1;
    while ($changed) {
        $changed = 0;
        for my $p (keys %parent) {
            if (!$tree{$p} && $tree{$parent{$p}}) {
                $tree{$p} = 1;
                $changed = 1;
            }
        }
    }
    return scalar grep { $stopped{$_} } keys %tree;
}

# Holders are busy during grace or when their tree reaches a CPU or RSS threshold.
sub holders {
    my $processes = snapshot();
    my @out;
    for my $file (glob "$dir/holders/*") {
        my $pid = basename($file);
        my $holder = decode_file($file);
        unless (live($pid, $holder) && ($holder->{epoch} // '') =~ /^\d+$/) {
            unlink $file;
            next;
        }
        my ($cpu, $rss, $busy) = measure($pid, $holder->{epoch}, $processes);
        push @out, { %$holder, pid => $pid, cpu => $cpu, rss => $rss, busy => $busy };
    }
    # Remove this transitional v1 lock block after all v1 wrappers have exited.
    my $old = "${root}arai-heavy.lock";
    my $pid = read_file("$old/pid");
    $pid =~ s/\s+//g;
    if ($pid =~ /^\d+$/ && $pid > 0 && kill(0, $pid)) {
        my @stat = stat($old);
        my $epoch = @stat ? $stat[9] : time;
        my ($cpu, $rss, $busy) = measure($pid, $epoch, $processes);
        push @out, {
            pid => $pid, epoch => $epoch, cpu => $cpu, rss => $rss,
            busy => $busy, project => 'v1', v1 => 1,
        };
    }
    return @out;
}

# Append ledger records and rotate old files under a separate lock.
sub ledger {
    my ($event, $fields) = @_;
    my $lock;
    unless (open($lock, '>>', "$state/ledger.lock") && flock($lock, LOCK_EX)) {
        warn "mac-heavy: warning: cannot write ledger; continuing\n";
        return;
    }
    my $file = "$state/ledger.jsonl";
    my $stamp = int(time);
    my $born = read_file("$state/ledger.started");
    $born = $stamp unless $born =~ /^\d+\s*$/;
    if (-f $file && ((-s $file) >= 10485760 || $stamp - $born >= 86400)) {
        rename $file, "$state/ledger.$stamp.$$.jsonl";
        $born = $stamp;
    }
    if (open my $marker, '>', "$state/ledger.started") {
        print $marker "$born\n";
        close $marker;
    }
    if (open my $out, '>>', $file) {
        my $record = {event => $event, time => $stamp, %$fields};
        print $out JSON::PP->new->canonical->encode($record), "\n";
        close $out;
    } else {
        warn "mac-heavy: warning: cannot write ledger; continuing\n";
    }
    for my $old (glob "$state/ledger.*.jsonl") {
        my @stat = stat($old);
        unlink $old if @stat && $stamp - $stat[9] > 30 * 86400;
    }
}
my $self = identity($$);
$self ne '' or die "mac-heavy: cannot read process identity; nothing ran\n";

# Status reports holders, waiters, the guard, and the last five ledger records.
if (@ARGV == 1 && $ARGV[0] eq 'status') {
    open my $gate, '>>', "$dir/lock"
        or die "mac-heavy: cannot open lock: $!; nothing ran\n";
    flock($gate, LOCK_EX) or die "mac-heavy: cannot lock queue: $!; nothing ran\n";
    for my $holder (holders()) {
        my $stopped = suspended($holder->{pid}) ? ' SUSPENDED' : '';
        printf "%s pid=%s age=%ds %s cpu %s%% rss %s MB project=%s %s%s\n",
            ($holder->{v1} ? 'v1 holder' : 'holder'), $holder->{pid},
            time - $holder->{epoch}, ($holder->{busy} ? 'BUSY' : 'IDLE'),
            $holder->{cpu}, $holder->{rss}, ($holder->{project} // 'unknown'),
            command_line($holder->{pid}, 100), $stopped;
    }
    print "waiters:\n";
    for my $file (glob "$dir/waiters/*") {
        my $pid = basename($file);
        my $waiter = decode_file($file);
        if (live($pid, $waiter)) {
            print "pid=$pid project=", ($waiter->{project} // ''),
                " executable=", ($waiter->{executable} // ''), "\n";
        } else {
            unlink $file;
        }
    }
    close $gate;
    my ($level, $line) = guard_status();
    print "guard: ", ($level eq 'unavailable' ? "unavailable ($line)" : $line),
        "\nledger (last 5):\n";
    if (open my $file, '<', "$state/ledger.jsonl") {
        my @lines = <$file>;
        if (@lines) {
            my $first = @lines > 5 ? @lines - 5 : 0;
            print @lines[$first .. $#lines];
        }
    }
    exit 0;
}

# Options select the wait limit, label, bypass, and command.
my $usage = 'usage: mac-heavy [--wait SECONDS] [--label LABEL] [--now] '
    . '[--] command [args...] | status';
sub refuse {
    my ($problem) = @_;
    warn "mac-heavy: $problem; nothing ran\n$usage\n";
    exit 2;
}
my ($wait, $label, $bypass) = (1800, '', 0);
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $arg = shift @ARGV;
    last if $arg eq '--';
    if ($arg eq '--help' || $arg eq '-h') {
        print "$usage\n";
        print "Coordinates CPU- and memory-heavy jobs.\n";
        print "Use mac-heavy status to see the queue.\n";
        print "Exit 75 means the wait timed out and nothing ran.\n";
        exit 0;
    } elsif ($arg eq '--now') {
        $bypass = 1;
    } elsif ($arg eq '--wait' || $arg eq '--label') {
        @ARGV or refuse("missing value for $arg");
        my $value = shift @ARGV;
        if ($arg eq '--wait') {
            $wait = $value;
        } else {
            $label = $value;
        }
    } else {
        refuse("unknown option $arg");
    }
}
$wait =~ /^\d+$/ && $wait <= 21600 or refuse('bad --wait value');
@ARGV or refuse('missing command');
$label !~ /[\r\n\t]/ or refuse('label must be a single line');
my $executable = basename($ARGV[0]);
my $project = basename($ENV{PWD} // '.');
my $start = time;
my $lease = "$$-" . int(time) . '-' . int(rand(1000000000));
my $own = "$dir/holders/$$";
my $waiter = "$dir/waiters/$$";
my %base = (
    executable => $executable, project => $project, label => $label,
    bypass => $bypass ? JSON::PP::true : JSON::PP::false,
);

# A matching inherited lease runs a nested command inline.
if (!$bypass && defined $ENV{MAC_HEAVY_LEASE} && length $ENV{MAC_HEAVY_LEASE}) {
    open my $gate, '>>', "$dir/lock"
        or die "mac-heavy: cannot open lock: $!; nothing ran\n";
    flock($gate, LOCK_EX) or die "mac-heavy: cannot lock queue: $!; nothing ran\n";
    my @holders = holders();
    close $gate;
    if (grep { ($_->{lease} // '') eq $ENV{MAC_HEAVY_LEASE} } @holders) {
        exec { $ARGV[0] } @ARGV;
        die "mac-heavy: exec: $!; nothing ran\n";
    }
    warn "mac-heavy: inherited lease does not match a current holder; queuing normally\n";
}

# Waiting and admission inspect and update holders under the queue lock.
my ($basis, $beside) = ('calm', 0);
$SIG{INT} = sub {
    unlink $waiter;
    exit 130;
};
$SIG{TERM} = sub {
    unlink $waiter;
    exit 143;
};
$SIG{HUP} = sub {
    unlink $waiter;
    exit 129;
};
if (!$bypass) {
    write_file($waiter, {
        start => $self, boot => $boot, project => $project, executable => $executable,
    });
    my ($last, $last_at, $notice) = ('', 0, 0);
    while (1) {
        open my $gate, '>>', "$dir/lock"
            or die "mac-heavy: cannot open lock: $!; nothing ran\n";
        flock($gate, LOCK_EX) or die "mac-heavy: cannot lock queue: $!; nothing ran\n";
        my @holders = holders();
        my @busy = grep { $_->{busy} } @holders;
        my ($level, $line) = guard_status();
        if ($level eq 'unavailable' && !$notice++) {
            warn "mac-heavy: memory guard status unavailable ($line); "
                . "admitting on the queue alone\n";
        }
        if (($level eq 'CALM' || $level eq 'unavailable') && @busy < $MAX_BUSY) {
            $beside = @holders;
            $basis = $level eq 'unavailable' ? 'guard-unavailable' : 'calm';
            write_file($own, {
                start => $self, epoch => int(time), boot => $boot, lease => $lease,
                label => $label, project => $project, executable => $executable,
            });
            close $gate;
            for my $holder (@holders) {
                next if $holder->{busy};
                warn sprintf "mac-heavy: started beside idle pid=%s %s "
                    . "(cpu %s%% rss %s MB)\n", $holder->{pid},
                    command_line($holder->{pid}, 60), $holder->{cpu}, $holder->{rss};
            }
            last;
        }
        my ($key, $reason, $message);
        if ($level ne 'CALM' && $level ne 'unavailable') {
            $key = "guard $level";
            $reason = "memory guard $line";
            $message = "mac-heavy: waiting: $reason";
        } else {
            my $holder = $busy[0];
            $key = "pid=$holder->{pid}";
            $reason = sprintf 'pid=%s %s (%ds, busy: cpu %s%% rss %s MB)',
                $holder->{pid}, command_line($holder->{pid}, 100),
                time - $holder->{epoch}, $holder->{cpu}, $holder->{rss};
            $message = "mac-heavy: waiting for $reason; "
                . 'run in the background or use --wait 0 and retry';
        }
        close $gate;
        my $elapsed = int(time - $start);
        if ($key ne $last || time - $last_at >= 60) {
            warn "$message\n";
            $last = $key;
            $last_at = time;
        }
        if ($elapsed >= $wait) {
            unlink $waiter;
            ledger('timeout', {%base, wait_seconds => $elapsed});
            warn "mac-heavy: timed out after ${elapsed}s ($reason); "
                . "nothing ran. Next: mac-heavy status\n";
            exit 75;
        }
        sleep(2 + rand());
    }
    unlink $waiter;
    $ENV{MAC_HEAVY_LEASE} = $lease;
} else {
    warn "mac-heavy: BYPASS: skipping queue and memory guard\n";
    $basis = 'bypass';
    delete $ENV{MAC_HEAVY_LEASE};
}

# Run the command in the same process group and forward signals once.
my $run = time;
my $waited = int($run - $start);
ledger('start', {
    %base, wait_seconds => $waited, run_seconds => 0, exit_status => undef,
    admission => $basis, beside => $beside,
});
my ($child, $term, $hup, $term_sent, $hup_sent);
$SIG{INT} = 'IGNORE';
$SIG{QUIT} = 'IGNORE';
$SIG{TERM} = sub {
    $term = 1;
    if ($child && !$term_sent) {
        $term_sent = 1;
        kill 'TERM', $child;
    }
};
$SIG{HUP} = sub {
    $hup = 1;
    if ($child && !$hup_sent) {
        $hup_sent = 1;
        kill 'HUP', $child;
    }
};
$child = fork();
defined $child or die "mac-heavy: fork: $!; nothing ran\n";
if (!$child) {
    $SIG{INT} = 'DEFAULT';
    $SIG{QUIT} = 'DEFAULT';
    $SIG{TERM} = 'DEFAULT';
    $SIG{HUP} = 'DEFAULT';
    exec { $ARGV[0] } @ARGV;
    warn "mac-heavy: cannot execute $ARGV[0]: $!; nothing ran\n";
    exit($!{ENOENT} ? 127 : 126);
}
if ($term && !$term_sent) {
    $term_sent = 1;
    kill 'TERM', $child;
}
if ($hup && !$hup_sent) {
    $hup_sent = 1;
    kill 'HUP', $child;
}
my $result;
while (1) {
    my $pid = waitpid($child, 0);
    if ($pid == $child) {
        $result = $?;
        last;
    }
    next if $!{EINTR};
    $result = 1 << 8;
    last;
}
unlink $own unless $bypass;
my $code = ($result & 127) ? 128 + ($result & 127) : $result >> 8;
ledger('end', {
    %base, wait_seconds => $waited, run_seconds => int(time - $run),
    exit_status => $code, admission => $basis,
});
exit $code;
